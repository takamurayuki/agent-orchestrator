{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Approved Task v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "repository",
    "baseRef",
    "requirements",
    "acceptanceCriteria",
    "verificationProfile"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "baseRef": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "given",
          "when",
          "then"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "given": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "type": "string",
            "minLength": 1
          },
          "then": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "verificationProfile": {
      "enum": [
        "node-pnpm"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxImplementationAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "default": 3
        },
        "maxDurationSeconds": {
          "type": "integer",
          "minimum": 60,
          "default": 2700
        },
        "cliTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "default": 900
        },
        "verificationTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "default": 300
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blockingSeverities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "default": [
            "critical",
            "high"
          ]
        }
      }
    },
    "expectedChanges": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "変更が予想されるファイル・領域（v0.2.0）。省略時はスコープ判定を行わない"
    },
    "conflictRisks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "既存機能との衝突の可能性（v0.2.0）"
    }
  }
}
