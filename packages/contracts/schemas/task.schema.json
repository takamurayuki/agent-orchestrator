{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Approved Task v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "repository",
    "baseRef",
    "requirements",
    "acceptanceCriteria",
    "verificationProfile"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "repository": {
      "type": "string",
      "minLength": 1
    },
    "baseRef": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "given",
          "when",
          "then"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "given": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "type": "string",
            "minLength": 1
          },
          "then": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "verificationProfile": {
      "enum": [
        "node-pnpm",
        "node-npm",
        "node-yarn"
      ]
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "maxImplementationAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3,
          "default": 3
        },
        "maxDurationSeconds": {
          "type": "integer",
          "minimum": 60,
          "default": 2700
        },
        "cliTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "default": 900
        },
        "verificationTimeoutSeconds": {
          "type": "integer",
          "minimum": 1,
          "default": 300
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "blockingSeverities": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": [
              "critical",
              "high",
              "medium",
              "low"
            ]
          },
          "default": [
            "critical",
            "high"
          ]
        }
      }
    },
    "expectedChanges": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "変更が予想されるファイル・領域（v0.2.0）。省略時はスコープ判定を行わない"
    },
    "conflictRisks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "既存機能との衝突の可能性（v0.2.0）"
    },
    "generatedArtifacts": {
      "type": "array",
      "description": "生成物の更新要件（v0.2.1）。Verifier が pnpm run <script> で再生成して最新であることを確認する",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "script",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "script": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_:.@/-]+$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "inputs": {
            "type": "array",
            "description": "生成スクリプトの入力の分類（v0.2.2）。リポジトリ調査が付与する",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "status",
                "detail"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "minLength": 1
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "tracked",
                    "ignored",
                    "missing",
                    "unknown"
                  ]
                },
                "detail": {
                  "type": "string"
                }
              }
            }
          },
          "inputStatus": {
            "type": "string",
            "enum": [
              "ok",
              "missing",
              "unknown"
            ],
            "description": "ok: 入力はすべて Git 追跡 / missing: Git 管理外の入力がある / unknown: 確定できない"
          }
        }
      }
    }
  }
}
