{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task Proposal v1",
  "description": "Requirements Agent が blockingQuestions=[] 到達後に生成する task.yaml の素案。repository/baseRef/verificationProfile/limits は Orchestrator が付与する。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "objective",
    "requirements",
    "outOfScope",
    "approach",
    "acceptanceCriteria",
    "openItems",
    "expectedChanges",
    "conflictRisks",
    "generatedArtifacts"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "outOfScope": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "approach": {
      "type": "string",
      "minLength": 1
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "given",
          "when",
          "then"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "given": {
            "type": "string",
            "minLength": 1
          },
          "when": {
            "type": "string",
            "minLength": 1
          },
          "then": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "openItems": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "expectedChanges": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "変更が予想されるファイル・領域（パス、ディレクトリ、glob）。Builder はこの範囲に拘束され、範囲外の重大な変更は人間の判断を求める（v0.2.0）"
    },
    "conflictRisks": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "description": "既存機能・既存実装との衝突の可能性と回避方法（v0.2.0）。無ければ空配列"
    },
    "generatedArtifacts": {
      "type": "array",
      "description": "生成物（スクリプトで再生成されるファイル）の更新要件（v0.2.1）。script は package.json の scripts 名。無ければ空配列",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "script",
          "reason"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "script": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_:.@/-]+$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
